# Copy this file to ".env" (same folder) and fill in the values yourself.
# .env is git-ignored. Never share it, paste it into chat, or commit it.

# Zerodha Kite Connect app (developers.kite.trade -> your app)
KITE_API_KEY=
KITE_API_SECRET=

# Telegram bot from @BotFather, and your own chat ID (see README step 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
